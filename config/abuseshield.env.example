# Este archivo solo explica nombres y relaciones. Los valores entre <> son
# inválidos a propósito y deben reemplazarse fuera del repositorio.
APP_ENV=production

# Identidad operativa derivada. No reutilizarla en otro servicio.
ABUSE_SHIELD_PRIVACY_KEY=<generate-a-unique-secret-outside-this-repository>

# La consola no forma parte de la entrada pública.
ABUSE_SHIELD_ADMIN_ENABLED=false
ABUSE_SHIELD_ADMIN_TOKEN=<generate-a-separate-operator-secret>
ABUSE_SHIELD_ADMIN_DEBUG_RAW=false

# Métricas y trazas deben quedar detrás de una frontera conocida.
ABUSE_SHIELD_METRICS_PUBLIC=false
ABUSE_SHIELD_RAW_TELEMETRY=false

# Solo habilita forwarding si el proxy real está declarado por red.
ABUSE_SHIELD_TRUST_CLIENT_HEADERS=false
ABUSE_SHIELD_TRUSTED_PROXY_CIDRS=<explicit-private-proxy-cidr-or-empty>

# Orden obligatorio: observe < challenge < block.
ABUSE_SHIELD_OBSERVE_THRESHOLD=30
ABUSE_SHIELD_CHALLENGE_THRESHOLD=60
ABUSE_SHIELD_BLOCK_THRESHOLD=90

# Mantener la autoridad en PHP hasta completar equivalencia y canary.
ABUSE_SHIELD_NATIVE_SHADOW=false
ABUSE_SHIELD_NATIVE_ENFORCE=false

# Los proveedores móviles requieren configuración y verificación de servidor.
ABUSE_SHIELD_MOBILE_INTEGRITY=false
ABUSE_SHIELD_GOOGLE_PLAY_INTEGRITY=false
ABUSE_SHIELD_APPLE_ATTEST_VERIFIER_URL=<leave-empty-until-a-real-verifier-is-configured>
