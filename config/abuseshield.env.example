# Marcadores inválidos para documentación. No usar como secretos.
APP_ENV=production
ABUSE_SHIELD_PRIVACY_KEY=<generate-a-unique-secret-outside-this-repository>
ABUSE_SHIELD_ADMIN_ENABLED=false
ABUSE_SHIELD_ADMIN_TOKEN=<generate-a-separate-operator-secret>
ABUSE_SHIELD_METRICS_PUBLIC=false
ABUSE_SHIELD_TRUST_CLIENT_HEADERS=false
ABUSE_SHIELD_TRUSTED_PROXY_CIDRS=<explicit-private-proxy-cidr-or-empty>
ABUSE_SHIELD_OBSERVE_THRESHOLD=30
ABUSE_SHIELD_CHALLENGE_THRESHOLD=60
ABUSE_SHIELD_BLOCK_THRESHOLD=90
