# Marcadores inválidos para documentación. No usar como secretos.
ABUSESHIELD_ENV=production
ABUSESHIELD_PRIVACY_KEY=<generate-a-unique-secret-outside-this-repository>
ABUSESHIELD_ADMIN_ENABLED=false
ABUSESHIELD_ADMIN_TOKEN=<generate-a-separate-operator-secret>
ABUSESHIELD_METRICS_PUBLIC=false
ABUSESHIELD_TRUST_CLIENT_HEADERS=false
ABUSESHIELD_TRUSTED_PROXY_CIDRS=<explicit-private-proxy-cidr-or-empty>
ABUSESHIELD_OBSERVE_THRESHOLD=30
ABUSESHIELD_CHALLENGE_THRESHOLD=60
ABUSESHIELD_BLOCK_THRESHOLD=90
