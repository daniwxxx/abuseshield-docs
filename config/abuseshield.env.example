# Este archivo solo explica nombres y relaciones. Los valores entre <> son
# inválidos a propósito y deben reemplazarse fuera del repositorio o generarse
# con ./abuseshield setup <edicion>.
APP_ENV=production

# Identidad operativa derivada por tenant. No reutilizarla en otro servicio.
ABUSE_SHIELD_PRIVACY_KEY=<generate-a-unique-secret-outside-this-repository>

# La consola no forma parte de la entrada pública (en core permanece en false).
ABUSE_SHIELD_ADMIN_ENABLED=false
ABUSE_SHIELD_ADMIN_TOKEN=<generate-a-separate-operator-secret>
ABUSE_SHIELD_ADMIN_DEBUG_RAW=false

# Métricas y trazas deben quedar detrás de una frontera conocida.
ABUSE_SHIELD_METRICS_PUBLIC=false
ABUSE_SHIELD_RAW_TELEMETRY=false

# Solo habilita forwarding y fingerprints si el proxy real está declarado por red.
ABUSE_SHIELD_TRUST_CLIENT_HEADERS=false
ABUSE_SHIELD_TRUSTED_PROXY_CIDRS=<explicit-private-proxy-cidr-or-empty>
ABUSE_SHIELD_PROXY_CIDRS=<explicit-nginx-realip-cidr-or-empty>
ABUSE_SHIELD_TRUST_EDGE_FINGERPRINT_HEADERS=false

# Cookie de clearance y orden obligatorio: observe < challenge < block.
ABUSE_SHIELD_CHALLENGE_SECURE_COOKIE=true
ABUSE_SHIELD_OBSERVE_THRESHOLD=30
ABUSE_SHIELD_CHALLENGE_THRESHOLD=60
ABUSE_SHIELD_BLOCK_THRESHOLD=90

# Mantener la autoridad en PHP hasta completar equivalencia y canary.
ABUSE_SHIELD_NATIVE_SHADOW=false
ABUSE_SHIELD_NATIVE_ENFORCE=false

# Integridad móvil v2: requiere registro Ed25519 firmado, keyring y proveedor.
ABUSE_SHIELD_MOBILE_INTEGRITY=false
ABUSE_SHIELD_MOBILE_REQUIRE_SHARED_STATE=true
ABUSE_SHIELD_MOBILE_REGISTRY_MODE=shadow
ABUSE_SHIELD_MOBILE_REGISTRY_PATH=/run/abuseshield-mobile/mobile-registry.signed.json
ABUSE_SHIELD_MOBILE_REGISTRY_KEYRING_PATH=/run/abuseshield-mobile/keyring.json
ABUSE_SHIELD_MOBILE_PROVIDERS=
ABUSE_SHIELD_GOOGLE_PLAY_INTEGRITY=false
ABUSE_SHIELD_GOOGLE_PLAY_CREDENTIALS_PATH=/run/abuseshield-mobile-secrets/google-play-service-account.json
ABUSE_SHIELD_APPLE_ATTEST_VERIFIER_URL=<leave-empty-until-a-real-verifier-is-configured>
ABUSE_SHIELD_APPLE_ATTEST_SIGNING_SECRET_PATH=/run/abuseshield-mobile-secrets/apple-attest-signing-secret
